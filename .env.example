PORT=5000

NODE_ENV=

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=realtime_tasks
DATABASE_URL=postgresql://postgres:replace_with_postgres_password@postgres:5432/realtime_tasks

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=

# OAuth - Google
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# OAuth - GitHub
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret